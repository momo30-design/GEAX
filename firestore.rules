rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Master Gate / Denial-by-default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'moses.mwale26@gmail.com'
      );
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // Connectivity check
    match /test/connection {
      allow read: if true;
    }

    // --- Entity Validations ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role'])
        && data.uid is string && data.uid.size() <= 128
        && data.name is string && data.name.size() <= 100
        && data.email is string && data.email.size() <= 100
        && data.role in ['buyer', 'producer', 'trader']
        && (!('company' in data) || (data.company is string && data.company.size() <= 100))
        && (!('region' in data) || (data.region is string && data.region.size() <= 100))
        && (!('paymentGateways' in data) || (data.paymentGateways is map))
        && data.uid == request.auth.uid;
    }

    function isValidContract(data) {
      return data.keys().hasAll(['id', 'title', 'value', 'buyerId', 'producerId', 'status'])
        && data.id is string && data.id.size() <= 100
        && data.title is string && data.title.size() <= 200
        && data.value is string && data.value.size() <= 50
        && data.buyerId is string && data.buyerId.size() <= 128
        && data.producerId is string && data.producerId.size() <= 128
        && data.status is string && data.status.size() <= 50;
    }

    function isValidInvestorInquiry(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'company', 'budget', 'interest'])
        && data.id is string && data.id.size() <= 100
        && data.name is string && data.name.size() <= 100
        && data.email is string && data.email.size() <= 100
        && data.company is string && data.company.size() <= 150
        && data.budget is string && data.budget.size() <= 100
        && data.interest is string && data.interest.size() <= 150
        && (!('message' in data) || (data.message is string && data.message.size() <= 2000));
    }

    // --- Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming())
        && incoming().isVerified == false; // Users cannot verify themselves
      allow update: if isOwner(userId)
        && isValidUser(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'company', 'region', 'paymentGateways', 'updatedAt'])
        && (incoming().updatedAt == request.time || !('updatedAt' in incoming()));
      allow delete: if isAdmin();
    }

    match /contracts/{contractId} {
      allow get: if isSignedIn() && (
        isOwner(existing().buyerId) || isOwner(existing().producerId) || isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid || resource.data.producerId == request.auth.uid || isAdmin()
      );
      allow create: if isSignedIn() && isValidContract(incoming())
        && (isOwner(incoming().producerId) || isAdmin()) // Producers or Admins initiate contracts
        && (exists(/databases/$(database)/documents/users/$(incoming().buyerId)) || isAdmin())
        && (incoming().createdAt == request.time || !('createdAt' in incoming()));
      allow update: if isSignedIn() && (
        isAdmin() ||
        (isOwner(existing().producerId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'highlights', 'terms'])) ||
        (isOwner(existing().buyerId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
      ) && isValidContract(incoming()) && (incoming().updatedAt == request.time || !('updatedAt' in incoming()));
      allow delete: if isAdmin();
    }

    // Sample/Public Contracts (Optional)
    match /sample_contracts/{contractId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Managed via console/cloud functions
    }

    // Investor Inquiries (PII Isolation & Zero-Trust)
    match /investor_inquiries/{inquiryId} {
      allow create: if isValidInvestorInquiry(incoming());
      allow read, update, delete: if isAdmin();
    }
  }
}
